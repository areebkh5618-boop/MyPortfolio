# Admin credentials — change these before deploying!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
ADMIN_SECRET=super-long-random-secret-at-least-16-chars

# MongoDB (required on Vercel for persistent projects/skills + images)
# https://cloud.mongodb.com → free M0 cluster
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# Image storage mode:
#   database   = base64 inside MongoDB (default, no Cloudinary needed)
#   cloudinary = CDN (optional, better for large/high-traffic sites)
#   local      = public/uploads folder (local/VPS only)
IMAGE_STORAGE=database

# Optional — only if IMAGE_STORAGE=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
